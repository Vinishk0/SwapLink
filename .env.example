# ---------------------------------------------------------------------------
# SwapLink bot — example environment file.
# Copy to `.env` and fill in real values: `cp .env.example .env`
# ---------------------------------------------------------------------------

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGgg
# Telegram IDs of admins, comma separated (get yours from @userinfobot)
ADMIN_IDS=123456789
# Drop updates accumulated while the bot was offline
DROP_PENDING_UPDATES=true

# --- Database ---------------------------------------------------------------
# SQLite — works out of the box, best for local runs / PyCharm:
DATABASE_URL=sqlite+aiosqlite:///data/swaplink.db
# PostgreSQL — for a running `docker compose up -d db` (compose sets this itself
# for the bot container, so you only need it when running the bot outside Docker):
# DATABASE_URL=postgresql+asyncpg://swaplink:swaplink@localhost:5432/swaplink
DB_ECHO=false

# Credentials used by the `db` service in docker-compose.yml
POSTGRES_USER=swaplink
POSTGRES_PASSWORD=swaplink
POSTGRES_DB=swaplink

# --- FSM storage ------------------------------------------------------------
# Leave empty to keep dialog states in memory (fine for a single instance).
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# --- Referral programme -----------------------------------------------------
# Discount the invited user gets on the exchange commission, in percent
REFERRAL_DISCOUNT_PERCENT=0.5
# Share of the deal volume credited to the inviter, in percent
REFERRAL_BONUS_PERCENT=0.5
# How many deals of the invited user are discounted (lifetime)
REFERRAL_DISCOUNT_LIMIT=3

# --- Exchange ---------------------------------------------------------------
# Accounting currency: referral balances and statistics are kept in it
BASE_CURRENCY=USDT
# Default exchange commission for new pairs, in percent
DEFAULT_COMMISSION_PERCENT=2
# Seed the empty database with a few demo currencies and pairs
SEED_DEMO_DATA=false

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
# Timezone used when showing dates to users
TIMEZONE=Europe/Moscow
# Public link to the operator/support account shown to users
SUPPORT_USERNAME=
